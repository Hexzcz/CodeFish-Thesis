# Copy to .env and fill in. .env is gitignored; this file must never hold
# real values.
#
#   cp .env.example .env
#
# Every setting is optional. With none of them set, CodeFish runs entirely
# from the bundled data in backend/data/ — which is the supported way to
# demo it offline.

# ── Road network and evacuation centers ─────────────────────────────────────
# Postgres/Supabase connection string. Supabase gives it under
# Settings -> Database -> Connection string (URI).
# Leave unset to read the bundled GeoJSON instead (no timeouts, works offline).
# DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── Live rainfall (JAXA GSMaP) ──────────────────────────────────────────────
# Free research account: register at https://sharaku.eorc.jaxa.jp/GSMaP/
# Without these, the rainfall panel reports that live rainfall is not
# configured and the simulator is used instead. Routing is unaffected.
# JAXA_USER=
# JAXA_PASS=

# ── Behaviour ───────────────────────────────────────────────────────────────
# Force the bundled data even when DATABASE_URL is set.
# USE_LOCAL_DATA=1

# Route requests allowed per caller per minute. Routing is the most expensive
# thing this server does; 30 is generous for a person and dull for a script.
# ROUTE_RATE_LIMIT=30

# ── Logging ─────────────────────────────────────────────────────────────────
# How much the app says: DEBUG, INFO (default), WARNING, ERROR.
# LOG_LEVEL=INFO

# The per-request scoring tables have their own level, so they can be silenced
# without going deaf to everything else.
# REPORT_LEVEL=WARNING
